ANTHROPIC_API_KEY=your_anthropic_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=owner/repository

# Primary model (CLI / workflow). Falls back when rate-limited or unavailable.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-20250514

# Live Playwright + disposable DB verification (heavy). Off by default for faster runs.
# LIVE_VERIFICATION_ENABLED=false

# Optional per-agent Claude settings (defaults shown)
# INVESTIGATOR_EFFORT=xhigh
# INVESTIGATOR_TEMPERATURE=0
# INVESTIGATOR_MAX_TOKENS=16000
# PROPOSER_EFFORT=high
# PROPOSER_TEMPERATURE=0
# PROPOSER_MAX_TOKENS=8000
# RESPONSE_PARSER_EFFORT=low
# RESPONSE_PARSER_TEMPERATURE=0
# RESPONSE_PARSER_MAX_TOKENS=2000
# IMPLEMENTER_EFFORT=high
# IMPLEMENTER_TEMPERATURE=0
# IMPLEMENTER_MAX_TOKENS=16000
# REVIEWER_EFFORT=medium
# REVIEWER_TEMPERATURE=0
# REVIEWER_MAX_TOKENS=8000
# REVIEWER_LIVE_EFFORT=high
